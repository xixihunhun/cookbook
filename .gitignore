# ============================================
# Cookbook .gitignore
# ============================================

# ========== Python ==========
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
build/
dist/
*.whl

# ========== 虚拟环境 ==========
venv/
.venv/
env/

# ========== 数据库 ==========
data/*.db
data/*.sqlite
data/*.sqlite3
instance/

# ========== 环境变量（含密钥，绝对不能提交）==========
.env
.env.*
!.env.example

# ========== 日志 ==========
*.log

# ========== Flask Migrate ==========
migrations/

# ========== Flask Static ==========
# Vue / Taro 构建产物
app/static/
app/static/**

# ========== Node / Taro ==========
node_modules/
web/node_modules/
web/dist/
web/.temp/
web/.cache/
web/.swc/
web/*.local
# 微信开发者工具私有配置（各人本地设置不同，不提交）
web/project.private.config.json
# 小程序私有配置
project.private.config.json

# ========== 系统 ==========
.DS_Store
Thumbs.db

# ========== IDE ==========
.idea/
.vscode/
*.swp
*.swo

# ========== 本地脚本 ==========
# 个人启动脚本可保留在本地，不提交
# start.sh
# stop.sh
# build-weapp.sh
