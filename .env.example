# ============================================
# Cookbook 环境变量模板
# 复制此文件为 .env（开发）或 .env.production（生产）后修改
# ============================================

# Flask 密钥（必须修改，用 python3 -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=change-me-to-a-random-string

# 数据库地址（开发环境不填则用 SQLite data/cook.db）
# MySQL:   mysql+pymysql://user:password@host:3306/cookbook
# PostgreSQL: postgresql://user:password@host:5432/cookbook
# DATABASE_URL=

# 微信小程序配置（真实微信登录必须填）
# 在微信公众平台 → 开发管理 → 开发设置 里获取
# WX_APPID=wx1234567890abcdef
# WX_SECRET=your-app-secret
